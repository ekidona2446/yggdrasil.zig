+/// Windows Vista / 7 console backend.
+///
+/// Since Windows 8 the standard library talks to the console by sending
+/// `IOCTL_CONDRV_ISSUE_USER_IO` to the ConDrv driver, passing a serialised
+/// console API call. Windows Vista and 7 predate ConDrv entirely: the console
+/// lives in CSRSS and is only reachable through the kernel32 console API.
+///
+/// Rather than patching each of the ~12 call sites in `Io.Threaded` and
+/// `std.Progress`, the request is intercepted here, at the single choke point
+/// all of them funnel through, and translated back into the kernel32 call it
+/// was serialised from. The console handle is taken from the request payload
+/// (`Request.Handle`), not from the device handle, because the latter is the
+/// ConDrv connection which does not exist on these systems.
+///
+/// Comptime-eliminated unless the target may run on Vista/7.
+const win7_condrv = struct {
+    const CONSOLE_SCREEN_BUFFER_INFO = extern struct {
+        dwSize: windows.COORD,
+        dwCursorPosition: windows.COORD,
+        wAttributes: windows.WORD,
+        srWindow: extern struct { Left: windows.SHORT, Top: windows.SHORT, Right: windows.SHORT, Bottom: windows.SHORT },
+        dwMaximumWindowSize: windows.COORD,
+    };
+
+    extern "kernel32" fn GetConsoleMode(hConsoleHandle: windows.HANDLE, lpMode: *windows.DWORD) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn SetConsoleMode(hConsoleHandle: windows.HANDLE, dwMode: windows.DWORD) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn GetConsoleOutputCP() callconv(.winapi) windows.UINT;
+    extern "kernel32" fn GetConsoleCP() callconv(.winapi) windows.UINT;
+    extern "kernel32" fn GetConsoleScreenBufferInfo(
+        hConsoleOutput: windows.HANDLE,
+        lpConsoleScreenBufferInfo: *CONSOLE_SCREEN_BUFFER_INFO,
+    ) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn SetConsoleCursorPosition(
+        hConsoleOutput: windows.HANDLE,
+        dwCursorPosition: windows.COORD,
+    ) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn FillConsoleOutputCharacterW(
+        hConsoleOutput: windows.HANDLE,
+        cCharacter: windows.WCHAR,
+        nLength: windows.DWORD,
+        dwWriteCoord: windows.COORD,
+        lpNumberOfCharsWritten: *windows.DWORD,
+    ) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn FillConsoleOutputAttribute(
+        hConsoleOutput: windows.HANDLE,
+        wAttribute: windows.WORD,
+        nLength: windows.DWORD,
+        dwWriteCoord: windows.COORD,
+        lpNumberOfAttrsWritten: *windows.DWORD,
+    ) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn ReadConsoleOutputCharacterW(
+        hConsoleOutput: windows.HANDLE,
+        lpCharacter: [*]u16,
+        nLength: windows.DWORD,
+        dwReadCoord: windows.COORD,
+        lpNumberOfCharsRead: *windows.DWORD,
+    ) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn SetConsoleTextAttribute(
+        hConsoleOutput: windows.HANDLE,
+        wAttributes: windows.WORD,
+    ) callconv(.winapi) windows.BOOL;
+    extern "kernel32" fn WriteConsoleW(
+        hConsoleOutput: windows.HANDLE,
+        lpBuffer: *const anyopaque,
+        nNumberOfCharsToWrite: windows.DWORD,
+        lpNumberOfCharsWritten: ?*windows.DWORD,
+        lpReserved: ?*anyopaque,
+    ) callconv(.winapi) windows.BOOL;
+
+    /// Layout of the serialised request; mirrors `CONSOLE.USER_IO.Request`
+    /// with the buffer counts left dynamic.
+    const RequestHeader = extern struct {
+        Handle: ?windows.HANDLE,
+        InputBuffersLength: u32,
+        OutputBuffersLength: u32,
+    };
+    const Buffer = extern struct { Size: u32, Pointer: usize };
+
+    /// The `Header` prefix each payload carries: operation code plus size.
+    const OpHeader = extern struct { Operation: windows.CONSOLE.USER_IO.Operation, Size: u32 };
+
+    fn buffers(req: [*]const u8, count: u32, offset: usize) []const Buffer {
+        const base: [*]const Buffer = @alignCast(@ptrCast(req + offset));
+        return base[0..count];
+    }
+
+    /// Translates one CONDRV request. Returns the NTSTATUS to report, or null
+    /// if the operation is not one the fallback implements (the caller then
+    /// lets the real ioctl run and fail as it would have anyway).
+    fn dispatch(in: []const u8) ?windows.NTSTATUS {
+        if (in.len < @sizeOf(RequestHeader)) return null;
+        const req: *const RequestHeader = @alignCast(@ptrCast(in.ptr));
+        const handle = req.Handle orelse return .INVALID_HANDLE;
+
+        const in_bufs = buffers(in.ptr, req.InputBuffersLength, @sizeOf(RequestHeader));
+        if (in_bufs.len == 0) return null;
+        const out_bufs = buffers(
+            in.ptr,
+            req.OutputBuffersLength,
+            @sizeOf(RequestHeader) + in_bufs.len * @sizeOf(Buffer),
+        );
+
+        // The first input buffer is the `Header.With(Data)` payload.
+        const payload: [*]u8 = @ptrFromInt(in_bufs[0].Pointer);
+        const op_header: *const OpHeader = @alignCast(@ptrCast(payload));
+        const data: [*]u8 = payload + @sizeOf(OpHeader);
+
+        switch (op_header.Operation) {
+            .GetMode => {
+                const mode: *windows.DWORD = @alignCast(@ptrCast(data));
+                return if (GetConsoleMode(handle, mode).toBool()) .SUCCESS else .INVALID_HANDLE;
+            },
+            .SetMode => {
+                const mode: *const windows.DWORD = @alignCast(@ptrCast(data));
+                return if (SetConsoleMode(handle, mode.*).toBool()) .SUCCESS else .INVALID_HANDLE;
+            },
+            .GetCP => {
+                const info: *windows.CONSOLE.USER_IO.INFO.CP = @alignCast(@ptrCast(data));
+                info.CodePage = switch (info.Mode) {
+                    .Input => GetConsoleCP(),
+                    .Output => GetConsoleOutputCP(),
+                };
+                return if (info.CodePage != 0) .SUCCESS else .INVALID_HANDLE;
+            },
+            .GetScreenBufferInfo => {
+                const info: *windows.CONSOLE.USER_IO.INFO.SCREEN_BUFFER = @alignCast(@ptrCast(data));
+                var raw: CONSOLE_SCREEN_BUFFER_INFO = undefined;
+                if (!GetConsoleScreenBufferInfo(handle, &raw).toBool()) return .INVALID_HANDLE;
+                info.* = .{
+                    .dwSize = raw.dwSize,
+                    .dwCursorPosition = raw.dwCursorPosition,
+                    .dwWindowPosition = .{ .X = raw.srWindow.Left, .Y = raw.srWindow.Top },
+                    .wAttributes = raw.wAttributes,
+                    .dwWindowSize = .{
+                        .X = raw.srWindow.Right - raw.srWindow.Left + 1,
+                        .Y = raw.srWindow.Bottom - raw.srWindow.Top + 1,
+                    },
+                    .dwMaximumWindowSize = raw.dwMaximumWindowSize,
+                    .wPopupAttributes = 0,
+                    .bFullscreenSupported = .FALSE,
+                    .ColorTable = @splat(0),
+                };
+                return .SUCCESS;
+            },
+            .SetCursorPosition => {
+                const coord: *const windows.COORD = @alignCast(@ptrCast(data));
+                return if (SetConsoleCursorPosition(handle, coord.*).toBool()) .SUCCESS else .INVALID_HANDLE;
+            },
+            .SetTextAttribute => {
+                const attr: *const windows.WORD = @alignCast(@ptrCast(data));
+                return if (SetConsoleTextAttribute(handle, attr.*).toBool()) .SUCCESS else .INVALID_HANDLE;
+            },
+            .Fill => {
+                const info: *windows.CONSOLE.USER_IO.INFO.FILL = @alignCast(@ptrCast(data));
+                var written: windows.DWORD = 0;
+                const ok = switch (info.Tag) {
+                    .WideCharacter => FillConsoleOutputCharacterW(
+                        handle,
+                        info.With.WideCharacter,
+                        info.nLength,
+                        info.dwWriteCoord,
+                        &written,
+                    ),
+                    .Character => FillConsoleOutputCharacterW(
+                        handle,
+                        info.With.Character,
+                        info.nLength,
+                        info.dwWriteCoord,
+                        &written,
+                    ),
+                    .Attribute => FillConsoleOutputAttribute(
+                        handle,
+                        info.With.Attribute,
+                        info.nLength,
+                        info.dwWriteCoord,
+                        &written,
+                    ),
+                };
+                if (!ok.toBool()) return .INVALID_HANDLE;
+                info.nLength = written;
+                return .SUCCESS;
+            },
+            .ReadOutputCharacter => {
+                const info: *windows.CONSOLE.USER_IO.INFO.READ_OUTPUT_CHARACTER = @alignCast(@ptrCast(data));
+                if (out_bufs.len == 0) return .INVALID_PARAMETER;
+                // The character buffer is the last output buffer; the first
+                // one aliases `Data` itself.
+                const chars_buf = out_bufs[out_bufs.len - 1];
+                const chars: [*]u16 = @ptrFromInt(chars_buf.Pointer);
+                var read: windows.DWORD = 0;
+                if (!ReadConsoleOutputCharacterW(
+                    handle,
+                    chars,
+                    chars_buf.Size / @sizeOf(u16),
+                    info.dwReadCoord,
+                    &read,
+                ).toBool()) return .INVALID_HANDLE;
+                info.nLength = read;
+                return .SUCCESS;
+            },
+            .Write => {
+                const info: *windows.CONSOLE.USER_IO.INFO.WRITE = @alignCast(@ptrCast(data));
+                if (in_bufs.len < 2) return .INVALID_PARAMETER;
+                const text = in_bufs[in_bufs.len - 1];
+                const ptr: [*]const u8 = @ptrFromInt(text.Pointer);
+                var written: windows.DWORD = 0;
+                const count: windows.DWORD = switch (info.Mode) {
+                    .WideCharacter => text.Size / @sizeOf(u16),
+                    .Character => text.Size,
+                };
+                if (!WriteConsoleW(handle, ptr, count, &written, null).toBool())
+                    return .INVALID_HANDLE;
+                info.Size = switch (info.Mode) {
+                    .WideCharacter => written * @sizeOf(u16),
+                    .Character => written,
+                };
+                return .SUCCESS;
+            },
+            else => return null,
+        }
+    }
+};
+
