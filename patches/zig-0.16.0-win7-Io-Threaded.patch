+// ═══════════════════════════════════════════════════════════════════════════
+//  Windows Vista / 7 console output compatibility
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// Since Windows 8 a console handle is a real NT kernel handle referring to an
+// object created by the ConDrv driver, so `NtWriteFile` writes to the console
+// exactly like it writes to a file. On Windows Vista and 7 there is no ConDrv:
+// console handles are CSRSS pseudo handles, tagged by having their two low
+// bits set (0x3, 0x7, 0xB, ...). `NtWriteFile` rejects them with
+// STATUS_INVALID_HANDLE, which surfaces as `error.NotOpenForWriting` and makes
+// every console program silently produce no output.
+//
+// `WriteConsoleW` is the documented API for those handles and exists since
+// Win2k. It is only reachable through kernel32, and only used after
+// `NtWriteFile` has actually failed on a handle that looks like a pseudo
+// handle, so Windows 8+ never executes any of this and pays only for a
+// never-taken branch on the error path.
+/// Comptime-eliminated when the target already guarantees Windows 8, so
+/// modern builds keep the plain NtWriteFile path with no extra branch.
+const win7_console_fallback_needed = is_windows and
+    !builtin.os.version_range.windows.min.isAtLeast(.win8);
+
+const win7_console = struct {
+    extern "kernel32" fn WriteConsoleW(
+        hConsoleOutput: windows.HANDLE,
+        lpBuffer: [*]const u16,
+        nNumberOfCharsToWrite: windows.DWORD,
+        lpNumberOfCharsWritten: ?*windows.DWORD,
+        lpReserved: ?*anyopaque,
+    ) callconv(.winapi) windows.BOOL;
+
+    /// CSRSS pseudo handles have their low two bits set. Real kernel handles
+    /// are always a multiple of four, so this never misfires on Windows 8+.
+    fn isPseudoConsoleHandle(handle: windows.HANDLE) bool {
+        return @intFromPtr(handle) & 0x3 == 0x3;
+    }
+
+    /// Writes WTF-8 to a Vista/7 console handle. Returns the number of *bytes*
+    /// consumed so the caller can treat it like a normal short write.
+    fn write(handle: windows.HANDLE, buffer: []const u8) File.Writer.Error!usize {
+        // Translate in bounded chunks so that no allocation is required. The
+        // chunk boundary is moved back to a UTF-8 sequence boundary so a
+        // multi-byte codepoint is never split across two calls.
+        var utf16_buf: [4096]u16 = undefined;
+        var byte_len = @min(buffer.len, 2048);
+        while (byte_len > 1 and buffer[byte_len - 1] & 0xC0 == 0x80) byte_len -= 1;
+        if (byte_len < buffer.len and buffer[byte_len - 1] & 0x80 != 0 and
+            buffer[byte_len - 1] & 0xC0 != 0x80) byte_len -= 1;
+        if (byte_len == 0) byte_len = @min(buffer.len, 2048);
+
+        const utf16_len = std.unicode.wtf8ToWtf16Le(&utf16_buf, buffer[0..byte_len]) catch
+            return error.Unexpected;
+        if (utf16_len == 0) return byte_len;
+
+        var written: windows.DWORD = 0;
+        if (!WriteConsoleW(handle, &utf16_buf, @intCast(utf16_len), &written, null).toBool())
+            return error.Unexpected;
+        if (written == utf16_len) return byte_len;
+
+        // Partial write: report the number of bytes matching the UTF-16 units
+        // that were accepted, re-encoding to find the split point.
+        var bytes: usize = 0;
+        var units: usize = 0;
+        var it: std.unicode.Wtf8Iterator = .{ .bytes = buffer[0..byte_len], .i = 0 };
+        while (it.nextCodepointSlice()) |slice| {
+            const cp_units: usize = if (slice.len == 4) 2 else 1;
+            if (units + cp_units > written) break;
+            units += cp_units;
+            bytes += slice.len;
+        }
+        return if (bytes == 0) error.Unexpected else bytes;
+    }
+};
