+/// Entropy fallback for systems without an accessible `\Device\CNG`.
+///
+/// `Io.Threaded.randomSecure` talks to the CNG device directly, which is the
+/// right call on Windows 8+. On Vista/7 the device exists but is not always
+/// reachable (and Wine does not implement it at all), in which case the
+/// documented user-mode entropy source is `RtlGenRandom`, exported by
+/// advapi32 under its ordinal name `SystemFunction036` since Windows XP.
+///
+/// Only reached after the CNG path has actually failed, so Windows 8+ never
+/// loads advapi32 because of this.
+const win7_random = struct {
+    extern "advapi32" fn SystemFunction036(
+        RandomBuffer: [*]u8,
+        RandomBufferLength: windows.ULONG,
+    ) callconv(.winapi) windows.BOOLEAN;
+
+    fn fill(buffer: []u8) bool {
+        var i: usize = 0;
+        while (i < buffer.len) {
+            // The API takes a ULONG length; chunk for very large requests.
+            const chunk = std.math.lossyCast(windows.ULONG, @min(buffer.len - i, 0xFFFF_FFFF));
+            if (!SystemFunction036(buffer[i..].ptr, chunk).toBool()) return false;
+            i += chunk;
+        }
+        return true;
+    }
+};
